# Copy this file to .env in the same directory. worker.py reads that .env.
# One KEY=VALUE per line. No quotes. No spaces around =.
# .env is gitignored. Leave the real token and bot token there.

# Inbox base address, for example http://203.0.113.10:8080
SERVER_URL=
# Same bearer token as the VPS (/etc/transcribe-inbox.env). At least 32 characters.
TOKEN=
# From BotFather.
TG_BOT_TOKEN=
# Numeric chat id from getUpdates. See README.md.
TG_CHAT_ID=
POLL_SECONDS=10
MODEL=large-v3
