[Unit]
Description=Transcribe video inbox (plain HTTP receiver)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=transcribe-inbox
Group=transcribe-inbox
WorkingDirectory=/opt/transcribe-inbox
EnvironmentFile=/etc/transcribe-inbox.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/transcribe-inbox/.venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
ReadWritePaths=/var/lib/transcribe-inbox

[Install]
WantedBy=multi-user.target
